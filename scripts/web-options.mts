// Mockups of the redesigned web report and portfolio (owner picks Q-RD2-1 to Q-RD2-4, 27 Oct 2026), built with the real shared drawings and the Ostravane sample numbers.
// Three options: A Solo Ledger led (big coloured tiles), B Cadre led (flat chips and meters), C the mix the owner chose (A tiles in the hero, B cards below). Sample data only.
// Run: node --experimental-strip-types scripts/web-options.mts <outdir>   then screenshot each html with headless Chrome.
import { mkdirSync, writeFileSync, readFileSync } from "node:fs";
import { C, HUE, concentricDrawing, gaugeColor, gaugeDrawing, heatmapDrawing, mapDrawing, rangeDrawing, toSvg, type Prof } from "../apps/web/lib/graphics/culture.ts";
import { INTER_800 } from "../apps/web/lib/export/fonts-inter.ts";

const out = process.argv[2] ?? "web-options";
mkdirSync(out, { recursive: true });
const NOW: Prof = { ENGAGE: 22, INNOVATE: 23, PERFORM: 30, GOVERN: 25 }, PREF: Prof = { ENGAGE: 34, INNOVATE: 30, PERFORM: 20, GOVERN: 16 };
const INK = "#131313", CREAM = "#FAF7F2", HAIR = "rgba(19,19,19,.09)", CORAL = "#F4B7A6", BUTTER = "#F6DE9A", SAGE = "#CFE3CF";
const fig = (d: ReturnType<typeof mapDrawing>, id: string) => toSvg(d, id);

const ICON: Record<string, string> = {
  portfolio: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 4v16"/>', reports: '<path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5M9 13h6M9 17h6"/>',
  plan: '<path d="M4 6l1.6 1.6L8.5 5M4 13l1.6 1.6L8.5 12"/><path d="M12 6.5h8M12 13.5h8M12 19h6"/>', explore: '<rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><circle cx="17" cy="17" r="4"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M16 6a3 3 0 0 1 0 6"/>', book: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/>',
};
const ic = (k: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICON[k]}</svg>`;

const font = `@font-face{font-family:IN;src:url(inter-400.ttf);font-weight:400}@font-face{font-family:IN;src:url(inter-500.ttf);font-weight:500}@font-face{font-family:IN;src:url(inter-600.ttf);font-weight:600 700}@font-face{font-family:IN;src:url(data:font/ttf;base64,${INTER_800});font-weight:800}`;
const base = `${font}
*{box-sizing:border-box}body{margin:0;background:${CREAM};color:${INK};font-family:IN,'DejaVu Sans',Arial,sans-serif;font-size:14px;line-height:1.5}
.app{display:grid;grid-template-columns:76px 1fr;min-height:100vh}
.side{background:#fff;border-right:1px solid ${HAIR};display:flex;flex-direction:column;align-items:center;gap:6px;padding:16px 0}
.side .lg{width:44px;height:44px;border-radius:12px;background:${INK};color:#fff;font-weight:800;display:grid;place-items:center;font-size:15px;margin-bottom:14px}
.side a{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;color:#6b675e}.side a.on{background:${INK};color:#fff}
.top{display:flex;align-items:center;gap:16px;padding:14px 32px;border-bottom:1px solid ${HAIR};background:${CREAM}}
.top .q{flex:1;max-width:420px;height:38px;border:1px solid ${HAIR};border-radius:999px;background:#fff;padding:0 16px;display:flex;align-items:center;color:#8b867a;font-size:13px}
.top .u{margin-left:auto;font-size:12.5px;color:#6b675e;display:flex;gap:12px;align-items:center}.top .u b{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:${INK};color:#fff;font-size:12px}
.main{padding:26px 32px 60px;max-width:1360px}
h1{font-size:30px;font-weight:800;letter-spacing:-.03em;margin:0}.sub{color:#6b675e;margin:2px 0 0}
.chip{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;background:#EFE9DD;color:#5a5750}
.chip.ok{background:#E3EFE3;color:#2F6F40}.chip.warn{background:#FBF0DA;color:#A86A00}.chip.bad{background:#FBE6E3;color:#B3261E}.chip.o{background:#FDEEE9;color:#C2401D}.chip.k{background:${INK};color:#fff}
.tabs{display:flex;gap:6px;margin:18px 0 18px;flex-wrap:wrap}.tabs span{padding:8px 16px;border-radius:999px;font-weight:700;font-size:13px;background:#fff;border:1px solid ${HAIR}}.tabs span.on{background:${INK};color:#fff;border-color:${INK}}
.card{background:#fff;border:1px solid ${HAIR};border-radius:22px;padding:20px 22px}
.lab{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#7a766c}
.exp{margin-top:12px;border-top:1px solid ${HAIR};padding-top:8px}.exp summary{cursor:pointer;font-weight:700;font-size:13px;color:#C2401D;list-style:none;display:flex;justify-content:space-between}.exp summary::after{content:"+";font-size:18px;line-height:1}
.exp[open] summary::after{content:"\\2212"}.exp p{margin:8px 0 0;font-size:13.5px}.exp p b{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:#7a766c;display:block}
.meter{height:8px;border-radius:6px;background:#EFE9DD;overflow:hidden}.meter>i{display:block;height:8px;border-radius:6px;background:#EB5733}
.key{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12px;color:#4a4740;margin-top:10px}.key i{display:inline-block;width:13px;height:13px;border-radius:3px;vertical-align:-2px;margin-right:5px}
.opt{position:fixed;right:18px;top:12px;z-index:5;background:${INK};color:#fff;border-radius:999px;padding:6px 14px;font-size:12px;font-weight:800;letter-spacing:.1em}
`;
const keyHtml = `<div class="key"><span><i style="background:#58A55C;opacity:.55"></i>Now (solid)</span><span><i style="border:2px dashed #EB5733"></i>Preferred (dashed)</span><span><i style="background:#EB5733;opacity:.5"></i>More wanted than Now</span><span><i style="background:#727070;opacity:.4"></i>Less wanted than Now</span></div>`;
const expander = (meaning: string, advice: string, open = false) => `<details class="exp"${open ? " open" : ""}><summary>What it means and what to do</summary><p><b>What it means</b>${meaning}</p><p><b>What to do</b>${advice}</p></details>`;
const frame = (opt: string, active: string, title: string, chips: string, inner: string) => `<!doctype html><html><head><meta charset="utf-8"><style>${base}</style></head><body><div class="opt">${opt}</div>
<div class="app"><aside class="side"><div class="lg">CDP</div>${["portfolio", "reports", "plan", "explore", "people", "book"].map((k) => `<a class="${k === active ? "on" : ""}" title="${k}">${ic(k)}</a>`).join("")}</aside>
<div><div class="top"><div class="q">Search reports, groups, actions</div><div class="u">Client Admin <b>OL</b></div></div>
<div class="main"><div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap"><div><h1>${title}</h1><p class="sub">Culture Dynamics Profile · Client leadership · Released 25 Oct 2026</p></div><div style="display:flex;gap:8px">${chips}</div></div>${inner}</div></div></div></body></html>`;

const MEANS = {
  now: "Perform leads how work gets done here at the moment: clear targets, accountability and attention to the market.", nowDo: "Protect what Perform does well, and watch for the other side of it: the number becoming the only story.",
  pref: "People most want Engage to lead: belonging, trust and care for one another.", prefDo: "Name Engage as the direction of the change and make one visible move towards it within 30 days.",
  align: "The culture does not yet carry what the strategy needs, so the strategy will feel the shortfall.", alignDo: "Name the orientation the strategy needs and agree the first priority with the executive team.",
  ready: "How much change the organisation can take on at once: enablement required.", readyDo: "Choose only as many priorities as this reading allows and close the pre conditions first.",
};
const heroMap = (id: string) => fig(mapDrawing("move", NOW, PREF, "GOVERN", 340), id);
const heat = toSvg(heatmapDrawing([{ label: "Finance", n: 8, suppressed: false, vals: [-3.5, -7.4, -0.3, 11.1] }, { label: "Operations", n: 12, suppressed: false, vals: [-5.6, -6.1, 4.3, 7.4] }, { label: "People and Culture", n: 6, suppressed: false, vals: [11.6, 2.1, -7.8, -5.9] }, { label: "Technology", n: 7, suppressed: false, vals: [2.6, 12.2, -8.2, -6.6] }], 480), "hm");
const rng = toSvg(rangeDrawing([{ label: "Engage", color: HUE.ENGAGE, a: 18, b: 23 }, { label: "Innovate", color: HUE.INNOVATE, a: 27, b: 22 }, { label: "Perform", color: HUE.PERFORM, a: 33, b: 30 }, { label: "Govern", color: HUE.GOVERN, a: 22, b: 25 }], "Executives", "Staff"), "rg");
const gauges = [["Digital readiness", 3.44], ["Speaking up safely", 3.23], ["Ready for change", 3.17]].map(([l, v]) => `<div style="text-align:center"><div class="lab" style="margin-bottom:4px">${l}</div><div style="max-width:150px;margin:0 auto">${toSvg(gaugeDrawing(v as number, 5, gaugeColor(v as number, 5)), "g" + l)}</div></div>`).join("");
const conc = toSvg(concentricDrawing(NOW, PREF, 300), "cc");

// ---------------------------------------------------------------- report, three options
const bigA = (label: string, value: string, word: string, fill: string, meaning: string, advice: string, o = false) => `<div style="background:${fill};border:1.5px solid ${INK};border-radius:22px;padding:18px 20px"><div class="lab" style="color:${INK};opacity:.7">${label}</div><div style="font-size:64px;font-weight:800;letter-spacing:-.04em;line-height:1;margin:8px 0 4px">${value}</div><div style="font-weight:800">${word}</div>${expander(meaning, advice, o)}</div>`;
const bigB = (label: string, value: string, word: string, tone: string, pct: number, meaning: string, advice: string) => `<div class="card"><div style="display:flex;justify-content:space-between;align-items:center"><span class="lab">${label}</span><span class="chip ${tone}">${word}</span></div><div style="font-size:38px;font-weight:800;letter-spacing:-.03em;margin:8px 0 8px">${value}</div><div class="meter"><i style="width:${pct}%"></i></div>${expander(meaning, advice)}</div>`;
const chartCard = (title: string, chipText: string, body: string, meaning: string, advice: string, open = false) => `<div class="card"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><b style="font-size:16px">${title}</b><span class="chip o">${chipText}</span></div>${body}${expander(meaning, advice, open)}</div>`;
const three = (fills: string[]) => ["Accelerator|Perform as the foundation|The culture runs on Perform now. It is the base the change can build on.", "Blocker 1|Engage deficit|People want much more Engage than they have. The strategy depends on behaviour the culture does not yet reward.", "Blocker 2|Adaptive capacity is the weakest readiness|Of the three readiness measures, adaptive capacity is lowest. Change that leans on it will meet resistance first."]
  .map((t, i) => { const [k, h, p] = t.split("|"); return `<div style="background:${fills[i]};border-radius:20px;padding:16px 18px"><span class="lab" style="color:${INK};opacity:.7">${k}</span><div style="font-weight:800;font-size:17px;margin:4px 0">${h}</div><div style="font-size:13px">${p}</div></div>`; }).join("");
const tabs = `<div class="tabs"><span class="on">Overview</span><span>Culture now</span><span>Groups</span><span>Readiness</span><span>Findings</span><span>Plan and KPIs</span><span>Everything</span></div>`;

const hero = (tiles: string) => `<div style="display:grid;grid-template-columns:minmax(380px,.95fr) 1.05fr;gap:18px;align-items:stretch"><div class="card" style="display:flex;flex-direction:column"><div style="display:flex;justify-content:space-between"><b style="font-size:16px">Now and Preferred culture</b><span class="chip">Now to Preferred</span></div><div style="flex:1;display:grid;place-items:center;padding:6px 0">${heroMap("hm1")}</div>${keyHtml}${expander("The four orientations as people describe the organisation now (solid) and as they want it to be (dashed). Orange shading means more is wanted.", "Start with the orientation with the largest orange step and agree one visible change within 30 days.")}</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">${tiles}</div></div>`;

const reportA = frame("OPTION A · Solo Ledger led", "reports", "Ostravane Logistics", `<span class="chip ok">Released 25 Oct</span><span class="chip k">Download</span>`, `${tabs}${hero(
  bigA("Now culture", "Perform", "then Govern", CORAL, MEANS.now, MEANS.nowDo, true) + bigA("Preferred culture", "Engage", "wanted +12 points", BUTTER, MEANS.pref, MEANS.prefDo) + bigA("Alignment", "81%", "Miss", "#fff", MEANS.align, MEANS.alignDo) + bigA("Readiness", "3.31", "Enablement required", SAGE, MEANS.ready, MEANS.readyDo))}
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:18px 0">${three([SAGE, CORAL, BUTTER])}</div>
<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px">${chartCard("The shape of the culture", "Four slices", conc, "Each slice is one orientation. Solid is Now, the dashed edge is Preferred.", "Look for the slice whose dashed edge reaches furthest beyond the solid.")}${chartCard("Executives and staff", "Two groups", rng, "A dot for each group on each orientation. The line between them is the difference.", "Where leaders and staff differ, hold a joint session before changing anything.")}${chartCard("Readiness", "Three measures", `<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px">${gauges}</div>`, "How well people and teams take on change.", "Protect speaking up safely first: it is the base every other change stands on.")}</div>`);

const reportB = frame("OPTION B · Cadre led", "reports", "Ostravane Logistics", `<span class="chip ok">Released 25 Oct</span><span class="chip k">Download</span>`, `${tabs}${hero(
  bigB("Now culture", "Perform", "then Govern", "o", 82, MEANS.now, MEANS.nowDo) + bigB("Preferred culture", "Engage", "+12 wanted", "ok", 68, MEANS.pref, MEANS.prefDo) + bigB("Alignment", "81%", "Miss", "bad", 81, MEANS.align, MEANS.alignDo) + bigB("Readiness", "3.31 / 5", "Enablement required", "warn", 66, MEANS.ready, MEANS.readyDo))}
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:18px 0">${three(["#fff", "#fff", "#fff"]).replace(/<div style="background:#fff;/g, `<div style="background:#fff;border:1px solid ${HAIR};`)}</div>
<div style="display:grid;grid-template-columns:1.3fr 1fr;gap:18px">${chartCard("Departments against the organisation", "4 groups", heat, "Each department against the organisation: colour means more than the organisation.", "Look at the departments that differ most and ask what they do differently.")}${chartCard("Executives and staff", "Two groups", rng, "A dot for each group on each orientation.", "Hold a joint session before changing anything.")}</div>`);

const reportC = frame("OPTION C · the mix", "reports", "Ostravane Logistics", `<span class="chip ok">Released 25 Oct</span><span class="chip k">Download</span>`, `${tabs}${hero(
  bigA("Now culture", "Perform", "then Govern", CORAL, MEANS.now, MEANS.nowDo, true) + bigA("Preferred culture", "Engage", "wanted +12 points", BUTTER, MEANS.pref, MEANS.prefDo) + bigB("Alignment", "81%", "Miss", "bad", 81, MEANS.align, MEANS.alignDo) + bigB("Readiness", "3.31 / 5", "Enablement required", "warn", 66, MEANS.ready, MEANS.readyDo))}
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:18px 0">${three([SAGE, CORAL, BUTTER])}</div>
<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px">${chartCard("The shape of the culture", "Four slices", conc, "Each slice is one orientation. Solid is Now, the dashed edge is Preferred.", "Look for the slice whose dashed edge reaches furthest beyond the solid.")}${chartCard("Departments", "4 groups", heat, "Each department against the organisation.", "Ask what the departments that differ most do differently.")}${chartCard("Readiness", "Three measures", `<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px">${gauges}</div>`, "How well people and teams take on change.", "Protect speaking up safely first.")}</div>`);

// ---------------------------------------------------------------- portfolio
const steps = ["Setup", "Fielding", "Scoring", "Reporting", "Debrief", "Planning", "Implementation", "Re-assessment"];
const strip = (at: number) => `<div style="display:flex;margin:14px 0 12px">${steps.map((s, i) => `<div style="flex:1;text-align:center;font-size:11px;font-weight:700;color:${i <= at ? INK : "#9a958a"};position:relative;padding-top:18px"><span style="position:absolute;left:0;right:0;top:5px;height:3px;background:${i <= at ? "#EB5733" : "#EAE4D8"}"></span><span style="position:absolute;left:50%;top:0;width:13px;height:13px;margin-left:-6.5px;border-radius:50%;background:${i < at ? "#EB5733" : "#fff"};border:${i === at ? "3px solid #EB5733" : "2px solid #fff"};box-shadow:0 0 0 1px ${i <= at ? "#EB5733" : "#EAE4D8"}"></span>${s}</div>`).join("")}</div>`;
const meters = (vals: [string, number, number][]) => `<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px">${vals.map(([l, v, of]) => `<div style="background:#F4EFE6;border-radius:14px;padding:10px 12px"><div class="lab" style="font-size:10.5px">${l}</div><div style="display:flex;justify-content:space-between;align-items:baseline;font-size:22px;font-weight:800;margin:2px 0 6px">${v}<span style="font-size:12px;color:#7a766c;font-weight:600">of ${of}</span></div><div class="meter"><i style="width:${Math.round((v / of) * 100)}%"></i></div></div>`).join("")}</div>`;
const engCard = (name: string, state: string, at: number, ms: [string, number, number][], next: string, links: string) => `<div class="card" style="margin-bottom:14px"><div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><div><b style="font-size:19px">${name}</b><div class="sub" style="font-size:13px">Cycle 1 · survey window closes 28 Oct</div></div><div style="display:flex;gap:8px;align-items:center"><span class="chip o">${state}</span><span class="chip">PAC Consultant</span></div></div>${strip(at)}${meters(ms)}<div style="display:flex;align-items:center;gap:12px;background:#FFF7F3;border:1px dashed #F0C9BB;border-radius:12px;padding:10px 14px;margin-top:12px"><span class="lab" style="color:#C2401D">Next step</span><span style="background:#EB5733;color:#fff;font-weight:700;border-radius:999px;padding:8px 18px">${next}</span></div><div style="margin-top:12px;font-size:12.5px;font-weight:700;display:flex;gap:14px;text-decoration:underline">${links}</div></div>`;
const filters = `<div class="tabs" style="margin-top:14px"><span class="on">Needs you (3)</span><span>Fielding</span><span>Reporting</span><span>Planning</span><span>Implementation</span><span>All (109)</span></div>`;
const clientHero = (variant: "A" | "B") => `<div style="display:grid;grid-template-columns:1.1fr 1fr;gap:18px"><div class="card" style="background:${variant === "A" ? CORAL : "#fff"};${variant === "A" ? `border:1.5px solid ${INK}` : ""}"><div class="lab">Your culture</div><div style="display:flex;gap:18px;align-items:center;margin-top:6px"><div style="width:230px">${fig(mapDrawing("move", NOW, PREF, "GOVERN", 300), "pm")}</div><div><div style="font-size:15px;font-weight:700">Now: <span style="font-size:40px;font-weight:800;letter-spacing:-.03em">Perform</span></div><div style="font-size:15px;font-weight:700;margin-top:6px">Preferred: <span style="font-size:40px;font-weight:800;letter-spacing:-.03em;color:${HUE.ENGAGE}">Engage</span></div><div style="margin-top:10px"><span class="chip bad">Alignment 81% Miss</span></div></div></div>${expander(MEANS.now, MEANS.nowDo)}</div>
<div class="card"><div class="lab">Where you are</div><div style="font-size:20px;font-weight:800;margin:6px 0 0">Step 4 of 8: Reporting</div><div class="sub" style="font-size:13px">Your PAC consultant has released your report.</div>${strip(3)}<div style="background:#FFF7F3;border:1px dashed #F0C9BB;border-radius:12px;padding:12px 14px;display:flex;gap:12px;align-items:center"><span class="lab" style="color:#C2401D">Your next step</span><span style="background:#EB5733;color:#fff;font-weight:700;border-radius:999px;padding:8px 18px">Review the action plan</span></div><div style="margin-top:12px">${meters([["Actions accepted", 0, 11], ["Actions under way", 0, 11]]).replace("repeat(4,1fr)", "repeat(2,1fr)")}</div></div></div>`;
const portfolioA = frame("OPTION A · Solo Ledger led (client view)", "portfolio", "Portfolio", `<span class="chip k">Preview the survey</span>`, `<div style="margin-top:18px">${clientHero("A")}</div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px">${[["Reports released", "1", SAGE], ["Actions accepted", "0 of 11", BUTTER], ["Responses", "41 of 45", "#fff"]].map(([l, v, f]) => `<div style="background:${f};border:1.5px solid ${INK};border-radius:22px;padding:16px 20px"><div class="lab" style="color:${INK};opacity:.7">${l}</div><div style="font-size:44px;font-weight:800;letter-spacing:-.04em">${v}</div></div>`).join("")}</div>`);
const portfolioB = frame("OPTION B · Cadre led (consultant view)", "portfolio", "Portfolio", `<span class="chip k">Preview the survey</span>`, `${filters}${engCard("Demo Retail Bank (fixture)", "Reporting", 3, [["Responses", 475, 475], ["Reports released", 57, 96], ["Actions accepted", 3, 11], ["Actions under way", 3, 3]], "Start the debrief", "<span>Organisational</span><span>Board summary</span><span>Explore groups</span><span>Action plan</span>")}${engCard("Live Demo Co", "Fielding", 1, [["Responses", 2, 7], ["Reports released", 0, 1], ["Actions accepted", 0, 1], ["Actions under way", 0, 1]], "Freeze the data", "<span>Leadership 360</span>")}`);
const portfolioC = frame("OPTION C · the mix (client view)", "portfolio", "Portfolio", `<span class="chip k">Preview the survey</span>`, `<div style="margin-top:18px">${clientHero("B").replace(/<div class="card" style="background:#fff;">/, `<div class="card">`)}</div>${filters.replace("Needs you (3)", "Your organisation (1)")}${engCard("Ostravane Logistics (sample)", "Reporting", 3, [["Reports released", 1, 1], ["Actions accepted", 0, 11], ["Actions under way", 0, 11], ["Journey", 4, 8]], "Review the action plan", "<span>Organisational report</span><span>Action plan</span><span>Explore groups</span>")}`);

for (const [n, h] of [["report-a", reportA], ["report-b", reportB], ["report-c", reportC], ["portfolio-a", portfolioA], ["portfolio-b", portfolioB], ["portfolio-c", portfolioC]] as const) writeFileSync(`${out}/${n}.html`, h);
console.log("written", out);
